local function createSlider(parent, title, min, max, default, order, callback)
	local speedContainer = Instance.new("Frame")
	speedContainer.Parent = parent; speedContainer.Size = UDim2.new(1, -6, 0, 56); speedContainer.BackgroundColor3 = CurrentTheme.CONTAINER_BG; speedContainer.LayoutOrder = order
	Instance.new("UICorner", speedContainer).CornerRadius = UDim.new(0, 6)
	local stroke = Instance.new("UIStroke"); stroke.Thickness = 1; stroke.Color = CurrentTheme.BORDER; stroke.Parent = speedContainer

	local speedLabel = Instance.new("TextLabel")
	speedLabel.Parent = speedContainer; speedLabel.Size = UDim2.new(1, -30, 0, 22); speedLabel.Position = UDim2.new(0, 14, 0, 8); speedLabel.BackgroundTransparency = 1; speedLabel.Text = title .. ": " .. default; speedLabel.TextColor3 = CurrentTheme.TEXT_SECONDARY; speedLabel.TextSize = 12; speedLabel.Font = Enum.Font.GothamMedium; speedLabel.TextXAlignment = Enum.TextXAlignment.Left

	local sliderBack = Instance.new("Frame")
	sliderBack.Parent = speedContainer; sliderBack.Size = UDim2.new(1, -28, 0, 4); sliderBack.Position = UDim2.new(0, 14, 0, 38); sliderBack.BackgroundColor3 = Color3.fromRGB(55, 55, 58)
	Instance.new("UICorner", sliderBack).CornerRadius = UDim.new(1, 0)

	local startPercent = (default - min) / (max - min)
	local sliderFill = Instance.new("Frame")
	sliderFill.Parent = sliderBack; sliderFill.Size = UDim2.new(startPercent, 0, 1, 0); sliderFill.BackgroundColor3 = CurrentTheme.ACCENT
	Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

	local sliderBtn = Instance.new("TextButton")
	sliderBtn.Parent = sliderBack; sliderBtn.Size = UDim2.new(0, 12, 0, 12); sliderBtn.Position = UDim2.new(startPercent, -6, 0.5, -6); sliderBtn.BackgroundColor3 = CurrentTheme.TEXT_PRIMARY; sliderBtn.Text = ""
	Instance.new("UICorner", sliderBtn).CornerRadius = UDim.new(1, 0)

	local dragging = false
	local function updateSlider(input)
		local backX = sliderBack.AbsolutePosition.X
		local backW = sliderBack.AbsoluteSize.X
		local percent = math.clamp((input.Position.X - backX) / backW, 0, 1)
		local value = math.round(min + (percent * (max - min)))
		speedLabel.Text = title .. ": " .. value
		sliderFill.Size = UDim2.new(percent, 0, 1, 0)
		sliderBtn.Position = UDim2.new(percent, -6, 0.5, -6)
		callback(value)
	end

	sliderBtn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end end)
	UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end end)
	UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
end

