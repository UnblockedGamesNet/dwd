RunService.RenderStepped:Connect(function()
	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	
	if humanoid and rootPart then
		if humanoid.WalkSpeed ~= customSpeed then humanoid.WalkSpeed = customSpeed end
		if customJump ~= 50 then 
			humanoid.UseJumpPower = true 
			if humanoid.JumpPower ~= customJump then humanoid.JumpPower = customJump end
		end
	end
	
	if noclipEnabled and character then
		for _, child in pairs(character:GetDescendants()) do
			if child:IsA("BasePart") and child.CanCollide then
				child.CanCollide = false
			end
		end
	end
	
	if flyEnabled and rootPart then
		local flyVelocity = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyVelocity = flyVelocity + Camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyVelocity = flyVelocity - Camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyVelocity = flyVelocity - Camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyVelocity = flyVelocity + Camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyVelocity = flyVelocity + Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then flyVelocity = flyVelocity - Vector3.new(0, 1, 0) end
		
		rootPart.AssemblyLinearVelocity = flyVelocity.Unit * (flyVelocity ~= Vector3.zero and flySpeed or 0)
		rootPart.Anchored = (flyVelocity == Vector3.zero)
	elseif rootPart and not isTeleporting and rootPart.Anchored and not dropdownOpen then
		rootPart.Anchored = false
	end
	
	if tpEnabled then
		if clickTool.Parent ~= LocalPlayer.Backpack and clickTool.Parent ~= character then
			clickTool.Parent = LocalPlayer.Backpack
		end
	else
		if clickTool.Parent == LocalPlayer.Backpack or clickTool.Parent == character then
			clickTool.Parent = nil
		end
	end
	
	if fovCircle then
		if fovRingEnabled then
			fovCircle.Position = UserInputService:GetMouseLocation()
			fovCircle.Radius = fovRadius
			fovCircle.Visible = true
		else
			fovCircle.Visible = false
		end
	end
	
	if espTracersEnabled and DrawingLib then
		for _, p in pairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				if teamCheckEnabled and p.Team == LocalPlayer.Team then
					if activeTracers[p] then activeTracers[p].Visible = false end
					continue
				end
				local hrp = p.Character.HumanoidRootPart
				local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
				
				if onScreen then
					local tracer = activeTracers[p]
					if not tracer then
						local created, res = pcall(function() return DrawingLib.new("Line") end)
						if created then tracer = res end
					end
					if tracer then
						tracer.Color = CurrentTheme.ACCENT
						tracer.Thickness = 1
						tracer.Transparency = 0.7
						tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
						tracer.To = Vector2.new(vector.X, vector.Y)
						tracer.Visible = true
						activeTracers[p] = tracer
					end
				elseif activeTracers[p] then
					activeTracers[p].Visible = false
				end
			elseif activeTracers[p] then
				activeTracers[p].Visible = false
			end
		end
	end
end)

