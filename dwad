local function smoothTeleport(targetCFrame)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	
	if hrp and targetCFrame and not isTeleporting then
		isTeleporting = true
		local oldAnchored = hrp.Anchored
		hrp.Anchored = true
		
		local startCFrame = hrp.CFrame
		local distance = (targetCFrame.Position - startCFrame.Position).Magnitude
		local duration = math.clamp(distance / 180, 0.35, 1.8)
		local elapsed = 0
		
		while elapsed < duration do
			elapsed = elapsed + task.wait()
			local percent = math.clamp(elapsed / duration, 0, 1)
			local smoothPercent = math.sin(percent * (math.pi / 2))
			
			if char and hrp and hrp.Parent then
				char:PivotTo(startCFrame:Lerp(targetCFrame, smoothPercent))
			else 
				break 
			end
		end
		
		if char and hrp and hrp.Parent then 
			char:PivotTo(targetCFrame) 
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.Anchored = oldAnchored
		end
		isTeleporting = false
	end
end

