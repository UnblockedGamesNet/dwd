local function switchTab(targetPage, targetBtn)
	activePage = targetPage
	searchBox.Text = ""
	for i, page in ipairs(pages) do
		local isTarget = (buttons[i] == targetBtn)
		page.Visible = (page == targetPage)
		TweenService:Create(buttons[i], TweenInfo.new(0.2, Enum.EasingStyle.Cubic), {BackgroundTransparency = isTarget and 0 or 1, TextColor3 = isTarget and CurrentTheme.TEXT_PRIMARY or CurrentTheme.TEXT_SECONDARY}):Play()
		TweenService:Create(buttons[i].Indicator, TweenInfo.new(0.2, Enum.EasingStyle.Cubic), {BackgroundTransparency = isTarget and 0 or 1}):Play()
		if isTarget then
			for _, item in pairs(page:GetChildren()) do if item:IsA("Frame") then item.Visible = true end end
		end
	end
end

